generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(uuid())
  name                 String
  email                String         @unique
  password             String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  operatedAppointments Appointment[]  @relation("OperatorAppointments")
  appointments         Appointment[]  @relation("CompanyAppointments")
  customers            Customer[]
  professionals        Professional[]
  services             Service[]
  tokens               UserToken[]
  financeEntries       FinanceEntry[]

  @@map("users")
}

model UserToken {
  id            String   @id @default(uuid())
  refresh_token String   @unique
  user_id       String
  expires_date  DateTime
  created_at    DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_tokens")
}

model Customer {
  id           String           @id @default(uuid())
  name         String
  address      String?
  status       CustomerStatus   @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  userId       String
  appointments Appointment[]
  contacts     Contact[]
  loyalty      CustomerLoyalty?
  financeEntries FinanceEntry[]
  user         User             @relation(fields: [userId], references: [id])

  @@map("customers")
}

model Contact {
  id         String      @id @default(uuid())
  customerId String
  type       ContactType
  value      String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  userId     String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])
  @@unique([userId, type, value])
  @@map("contacts")
}

model CustomerLoyalty {
  id         String    @id @default(uuid())
  customerId String    @unique
  visits     Int       @default(0)
  totalSpent Decimal   @default(0) @db.Decimal(10, 2)
  lastVisit  DateTime?
  updatedAt  DateTime  @updatedAt
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@map("customer_loyalty")
}

model Professional {
  id                 String                @id @default(uuid())
  name               String
  address            String
  phone              String
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  userId             String
  appointmentItems   AppointmentItem[]
  authorizedServices ProfessionalService[]
  user               User                  @relation(fields: [userId], references: [id])

  @@map("professionals")
}

model Service {
  id               String                @id @default(uuid())
  name             String
  price            Decimal               @db.Decimal(10, 2)
  description      String?
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  userId           String
  appointmentItems AppointmentItem[]
  professionals    ProfessionalService[]
  user             User                  @relation(fields: [userId], references: [id])

  @@map("services")
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id])
  service        Service      @relation(fields: [serviceId], references: [id])

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

model Appointment {
  id              String            @id @default(uuid())
  customerId      String
  registeredById  String
  appointmentDate DateTime
  subtotal        Decimal           @default(0) @db.Decimal(10, 2)
  discount        Decimal           @default(0) @db.Decimal(10, 2)
  total           Decimal           @default(0) @db.Decimal(10, 2)
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus     @default(PENDING)
  paidAmount      Decimal           @default(0) @db.Decimal(10, 2)
  paidAt          DateTime?
  financeEntries  FinanceEntry[]
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  userId          String
  deletedAt       DateTime?
  items           AppointmentItem[]
  customer        Customer          @relation(fields: [customerId], references: [id])
  operator        User              @relation("OperatorAppointments", fields: [registeredById], references: [id])
  company         User              @relation("CompanyAppointments", fields: [userId], references: [id])

  @@index([appointmentDate])
  @@map("appointments")
}

model AppointmentItem {
  id               String        @id @default(uuid())
  appointmentId    String
  serviceId        String?
  professionalId   String?
  serviceName      String
  professionalName String
  value            Decimal       @db.Decimal(10, 2)
  appointment      Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  professional     Professional? @relation(fields: [professionalId], references: [id])
  service          Service?      @relation(fields: [serviceId], references: [id])

  @@map("appointment_items")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  DEBIT_CARD
  CREDIT_CARD
  CASH
  PIX
  OTHER
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

model FinanceEntry {
  id            String @id @default(uuid())
  userId        String
  customerId    String?
  appointmentId String?
  kind          String
  status        String @default("POSTED")
  description   String
  category      String
  cashCents     Int @default(0)
  creditCents   Int @default(0)
  appliedCents  Int @default(0)
  method        PaymentMethod?
  occurredAt    DateTime
  dueAt         DateTime?
  createdAt     DateTime @default(now())
  requestId     String
  reversalOfId  String? @unique
  user          User @relation(fields: [userId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  reversalOf    FinanceEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversal      FinanceEntry? @relation("EntryReversal")

  @@unique([userId, requestId])
  @@index([userId, occurredAt])
  @@index([customerId])
  @@index([appointmentId])
  @@map("finance_entries")
}

enum ContactType {
  WHATSAPP
  INSTAGRAM
}
