generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  DEBIT_CARD
  CREDIT_CARD
  CASH
  PIX
  OTHER
}

enum PaymentStatus {
  PAID
  PENDING
}

enum ContactType {
  WHATSAPP
  INSTAGRAM
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers     Customer[]
  professionals Professional[]
  services      Service[]

  appointments         Appointment[] @relation("CompanyAppointments")
  operatedAppointments Appointment[] @relation("OperatorAppointments")

  tokens UserToken[]

  @@map("users")
}

model UserToken {
  id            String   @id @default(uuid())
  refresh_token String   @unique
  user_id       String
  expires_date  DateTime
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_tokens")
}

model Customer {
  id      String         @id @default(uuid())
  userId  String
  name    String
  address String?
  status  CustomerStatus @default(ACTIVE)

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  appointments Appointment[]
  loyalty      CustomerLoyalty?

  contacts Contact[]

  @@map("customers")
}

model Contact {
  id         String      @id @default(uuid())
  customerId String
  userId     String
  type       ContactType
  value      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])       // 1 por tipo por cliente
  @@unique([userId, type, value])   // não repete dentro da empresa

  @@map("contacts")
}

model CustomerLoyalty {
  id         String @id @default(uuid())
  customerId String @unique

  visits     Int      @default(0)
  totalSpent Decimal  @default(0) @db.Decimal(10, 2)
  lastVisit  DateTime?

  updatedAt DateTime @updatedAt
  customer  Customer @relation(fields: [customerId], references: [id])

  @@map("customer_loyalty")
}

model Professional {
  id      String @id @default(uuid())
  userId  String
  name    String
  address String
  phone   String

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                  @relation(fields: [userId], references: [id])
  authorizedServices ProfessionalService[]
  appointmentItems   AppointmentItem[]

  @@map("professionals")
}

model Service {
  id          String  @id @default(uuid())
  userId      String
  name        String
  price       Decimal @db.Decimal(10, 2)
  description String?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                  @relation(fields: [userId], references: [id])
  professionals    ProfessionalService[]
  appointmentItems AppointmentItem[]

  @@map("services")
}

model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

model Appointment {
  id             String   @id @default(uuid())
  userId         String
  customerId     String
  registeredById String

  appointmentDate DateTime
  deletedAt       DateTime?

  subtotal Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(PENDING)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  User     @relation("CompanyAppointments", fields: [userId], references: [id])
  operator User     @relation("OperatorAppointments", fields: [registeredById], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  items AppointmentItem[]

  @@index([appointmentDate])
  @@map("appointments")
}

model AppointmentItem {
  id             String  @id @default(uuid())
  appointmentId  String
  serviceId      String?
  professionalId String?

  serviceName      String
  professionalName String
  value            Decimal @db.Decimal(10, 2)

  appointment  Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@map("appointment_items")
}